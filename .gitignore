node_modules/
dist/
.DS_Store
*.local
.vite/

# vite 开发服务器每次启动都会在项目根落一个临时配置快照（已累积 40+ 个）
vite.config.ts.timestamp-*.mjs

# 后端落盘数据（本地开发用，不入库）
server/data/

# 云函数里的 _lib 副本是生成物（源：cloudfunctions/_lib/），由 npm run cloud:sync-lib 生成
cloudfunctions/*/_lib/

# 迁移快照含真实用户数据，绝不入库
cloudfunctions/migrate/snapshot.json

# 密钥文件一律不入库
.env
