{
  "name": "tongxing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mp-weixin": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js -p mp-weixin",
    "build:mp-weixin": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js build -p mp-weixin && node scripts/patch-vendor.mjs && node scripts/cloud-lib-sync.mjs && node scripts/patch-mp-cloud.mjs",
    "dev:h5": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js",
    "build:h5": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js build",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "server": "node server/index.mjs",
    "hooks:install": "node scripts/hooks-install.mjs",
    "fix:env": "node scripts/fix-env.mjs",
    "smoke:offline": "npm run server:smoke && npm run client:smoke && npm run city:smoke",
    "itin:smoke": "node scripts/itin-check-test.mjs",
    "genstage:smoke": "node scripts/gen-stage-test.mjs",
    "expr:smoke": "node scripts/expense-expr-test.mjs",
    "packing:smoke": "node scripts/packing-test.mjs",
    "fx:smoke": "node scripts/fx-test.mjs",
    "server:smoke": "node server/smoke.mjs",
    "client:smoke": "node scripts/client-sync-test.mjs",
    "city:smoke": "node scripts/city-smoke-test.mjs",
    "amap:smoke": "node scripts/amap-itin-test.mjs",
    "devtools": "node scripts/open-devtools.mjs",
    "devtools:build": "npm run build:mp-weixin && node scripts/open-devtools.mjs",
    "e2e:keypad": "node scripts/expense-keypad-e2e.mjs",
    "e2e:capture": "node scripts/quick-capture-e2e.mjs",
    "appid": "node scripts/set-appid.mjs",
    "wxss:lint": "node scripts/lint-wxss.mjs",
    "check:tokens": "node scripts/check-token-sync.mjs",
    "markers": "node scripts/gen-markers.mjs",
    "palette:search": "node scripts/search-palette.mjs",
    "palette:audit": "node scripts/check-palette.mjs",
    "contrast:audit": "node scripts/check-contrast.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "patch:vendor": "node scripts/patch-vendor.mjs",
    "cloud:sync-lib": "node scripts/cloud-lib-sync.mjs",
    "cloud:patch": "node scripts/patch-mp-cloud.mjs",
    "cloud:smoke": "node scripts/cloud-lib-sync.mjs && node scripts/cloud-smoke-test.mjs",
    "lib:parity": "node scripts/cloud-lib-sync.mjs && node scripts/lib-parity-test.mjs",
    "cloud:setup": "node scripts/cloud-setup.mjs",
    "cloud:verify": "node scripts/cloud-setup.mjs --verify",
    "migrate:export": "node scripts/migrate-export.mjs",
    "test": "npm run server:smoke && npm run client:smoke && npm run city:smoke && npm run itin:smoke && npm run plan:smoke && npm run budget:smoke && npm run genstage:smoke && npm run expr:smoke && npm run packing:smoke && npm run fx:smoke && npm run lib:parity && npm run cloud:smoke && npm run amap:smoke",
    "verify": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node scripts/check-token-sync.mjs && node scripts/check-contrast.mjs && node scripts/check-palette.mjs && node scripts/check-platform.mjs && npm run build:mp-weixin && node scripts/lint-wxss.mjs && npm run lib:parity && npm run cloud:smoke && node scripts/city-smoke-test.mjs",
    "plan:smoke": "node scripts/plan-quality-test.mjs",
    "budget:smoke": "node scripts/budget-test.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5020420260813003",
    "pinia": "^2.3.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "esbuild": "^0.25.0",
    "miniprogram-automator": "^0.12.1",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.12"
  }
