    "appid": "node scripts/set-appid.mjs",
    "wxss:lint": "node scripts/lint-wxss.mjs",
    "check:tokens": "node scripts/check-token-sync.mjs",
    "markers": "node scripts/gen-markers.mjs",
    "palette:search": "node scripts/search-palette.mjs",
    "palette:audit": "node scripts/check-palette.mjs",
    "contrast:audit": "node scripts/check-contrast.mjs",
    "test": "npm run server:smoke && npm run client:smoke && npm run city:smoke && npm run amap:smoke",
    "verify": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node scripts/check-token-sync.mjs && node scripts/check-contrast.mjs && node scripts/check-palette.mjs && node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js build -p mp-weixin && node scripts/lint-wxss.mjs && node scripts/city-smoke-test.mjs"
